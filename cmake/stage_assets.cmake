cmake_path(ABSOLUTE_PATH SOURCE NORMALIZE OUTPUT_VARIABLE sourceRoot)
cmake_path(ABSOLUTE_PATH DESTINATION NORMALIZE OUTPUT_VARIABLE targetRoot)
cmake_path(ABSOLUTE_PATH BINARY_ROOT NORMALIZE OUTPUT_VARIABLE buildRoot)
cmake_path(IS_PREFIX buildRoot "${targetRoot}" NORMALIZE insideBuild)
cmake_path(GET targetRoot FILENAME targetName)
if(NOT insideBuild OR targetRoot STREQUAL buildRoot OR NOT targetName STREQUAL "assets")
    message(FATAL_ERROR "Asset staging destination must be an assets directory inside the build tree.")
endif()
if(NOT IS_DIRECTORY "${sourceRoot}")
    message(FATAL_ERROR "Asset staging source is missing.")
endif()

execute_process(COMMAND "${CMAKE_COMMAND}" -E copy_directory "${sourceRoot}" "${targetRoot}"
    COMMAND_ERROR_IS_FATAL ANY)

# Copying alone leaves deleted/renamed pack files visible to Editor and runtime tests.
file(GLOB_RECURSE stagedFiles LIST_DIRECTORIES FALSE "${targetRoot}/*")
foreach(staged IN LISTS stagedFiles)
    file(RELATIVE_PATH relative "${targetRoot}" "${staged}")
    if(NOT EXISTS "${sourceRoot}/${relative}")
        file(REMOVE "${staged}")
    endif()
endforeach()

file(GLOB_RECURSE stagedEntries LIST_DIRECTORIES TRUE "${targetRoot}/*")
list(SORT stagedEntries ORDER DESCENDING)
foreach(staged IN LISTS stagedEntries)
    if(IS_DIRECTORY "${staged}")
        file(GLOB children "${staged}/*" "${staged}/.[!.]*")
        if(NOT children)
            file(REMOVE_RECURSE "${staged}")
        endif()
    endif()
endforeach()
